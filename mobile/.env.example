# ── MetraVision AI Mobile — environment ───────────────────────────────────────────
# Copy to `.env`. Both values are optional; the defaults work for most setups.

# Backend API base URL, including the /api suffix.
#
# LEAVE THIS EMPTY FIRST. With no value the app derives the host from the Expo
# dev-server address it was loaded from, which is correct for a physical device
# on the same Wi-Fi and for the Android emulator alike. Set it only when the
# backend runs somewhere other than the machine serving Metro.
#
#   Android emulator   http://10.0.2.2:4000/api
#   iOS simulator      http://localhost:4000/api
#   Physical device    http://<your-LAN-IP>:4000/api      e.g. 192.168.1.7
#   Deployed           https://api.example.gov.in/api
#
# `npm run dev` in backend/ prints the LAN address to use.
EXPO_PUBLIC_API_URL=

# Set to `true` to run without a backend. The Phase 1 mock service layer was
# removed when the API landed, so this is now a diagnostic switch only.
EXPO_PUBLIC_USE_MOCK=false
