{
  "name": "metravision-ai",
  "version": "1.0.0",
  "private": true,
  "description": "MetraVision AI — Legal Metrology packaged-commodity compliance scanner. Root scripts that run the OCR sidecar and the API together.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --prefix backend run dev",
    "dev:ocr": "node scripts/ocr.mjs",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "testing": "npm --prefix backend run testing --",
    "test": "npm --prefix backend test",
    "typecheck": "npm --prefix backend run typecheck",
    "lint": "npm --prefix backend run lint"
  }
}
