# ── SIH26034 Backend — environment ──────────────────────────────────────────
# Copy to `.env`. Every value below has a working default, so an empty .env
# still runs; the defaults are development-only.

NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────────────────────
# Leave MONGODB_URI empty and the server starts an in-process MongoDB via
# mongodb-memory-server — no installation required, but data is discarded on
# restart. Set it for a durable database:
#   local mongod : mongodb://127.0.0.1:27017
#   Docker       : mongodb://127.0.0.1:27017
#   Atlas        : mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=sih26034

# ── Auth ────────────────────────────────────────────────────────────────────
# CHANGE BOTH before any non-local deployment.
JWT_ACCESS_SECRET=sih26034-dev-access-secret-change-me
JWT_REFRESH_SECRET=sih26034-dev-refresh-secret-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# ── HTTP ────────────────────────────────────────────────────────────────────
# `*` during local development; a comma-separated origin list in production.
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Image storage ───────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=12

# ── Analysis ────────────────────────────────────────────────────────────────
# mock → scripted analyser (Phase 2). http → Python AI service (Phase 3).
# Flipping this variable is the entire integration step for real OCR.
ANALYSIS_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=20000
MOCK_ANALYSIS_DELAY_MS=1200

# ── OCR ─────────────────────────────────────────────────────────────────────
# The provider behind `OCRProvider`. Everything downstream — extraction, the
# rule engine, the report, both clients — depends on the interface and not on
# this value, so replacing the provider later is a change here and one class in
# src/services/ocr/.
#
#   mock   → deterministic fixtures. READS NOTHING. Returns one of a few sample
#            labels chosen by hashing the image bytes, so the declarations you
#            get back belong to a sample package and not to the one you
#            photographed. Fine for CI and for demoing the rule engine; useless
#            for judging extraction accuracy.
#   gemini → Gemini Flash reading the label as a vision-language model. Best
#            recall on curved, angled and bilingual Indian packaging. Returns no
#            bounding boxes and no confidence, so findings cannot be highlighted
#            on the photograph and failed checks route to review rather than to
#            a violation.
#   google → Google Cloud Vision DOCUMENT_TEXT_DETECTION. Per-word confidence
#            and bounding polygons, so a finding can be shown on the image.
#
# To actually read a label, set one of the two cloud providers AND a key below.
OCR_PROVIDER=mock

# Gemini model, when OCR_PROVIDER=gemini. Flash rather than Pro: transcription
# is not a reasoning task, and Flash is cheaper and faster for the same job.
GEMINI_MODEL=gemini-3.6-flash

# Credentials for the cloud providers. Required for gemini and google alike.
# NEVER commit a real value, and never ship either to the mobile or web client:
# every OCR call is made from this process precisely so the credential stays on
# the server.
#
#   OCR_API_KEY                    OCR_PROVIDER=google : a Vision-enabled Google
#                                  Cloud API key.
#                                  OCR_PROVIDER=gemini : a Google AI Studio key
#                                  from https://aistudio.google.com/apikey
#   GOOGLE_APPLICATION_CREDENTIALS absolute path to a service-account JSON file.
#                                  Google Vision only; Gemini has no
#                                  service-account path.
#
# The key wins if both are set.
OCR_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# How long to wait for the OCR service before giving up on one image.
OCR_TIMEOUT_MS=20000

# Comma-separated BCP-47 hints. Indian packages are routinely bilingual; leave
# this empty to let the provider auto-detect.
OCR_LANGUAGE_HINTS=en,hi

# Pins the mock provider to one fixture instead of choosing by image content.
# One of: compliant, missing_declarations, imported_no_origin, low_confidence, blank
OCR_MOCK_FIXTURE=

# Visible processing time for the mock provider during a demo. Ignored in tests.
MOCK_OCR_DELAY_MS=600

# How completely one, two, three or four-plus photographs are taken to have
# captured a package, as a 0-1 score handed to the rule engine.
#
# This is an evidentiary policy, not law, which is why it is configuration. It
# decides whether a declaration that was not found can be recorded as a missing
# declaration or must be sent for review: the engine will not call an absence a
# violation below 0.7, so a single photograph of the front face never can. Raise
# the first rung only if you are prepared to defend a finding made from one
# photograph.
CAPTURE_COMPLETENESS_BY_IMAGE_COUNT=0.45,0.7,0.85,0.95

# ── Misc ────────────────────────────────────────────────────────────────────
# Seeds demo data on boot when the database is empty. Never overwrites data.
AUTO_SEED=true
LOG_LEVEL=info
