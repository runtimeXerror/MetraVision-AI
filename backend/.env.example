# ── SIH26034 Backend — environment ──────────────────────────────────────────
# Copy to `.env`. Every value below has a working default, so an empty .env
# still runs; the defaults are development-only.

NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────────────────────
# Leave MONGODB_URI empty and the server starts an in-process MongoDB via
# mongodb-memory-server — no installation required, but data is discarded on
# restart. Set it for a durable database:
#   local mongod : mongodb://127.0.0.1:27017
#   Docker       : mongodb://127.0.0.1:27017
#   Atlas        : mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=sih26034

# The destination for `npm run migrate:atlas`, which copies the database from
# MONGODB_URI to here. Only needed while moving between deployments — once the
# move is done, MONGODB_URI points at the cluster and this can go.
MONGODB_URI_ATLAS=

# ── Auth ────────────────────────────────────────────────────────────────────
# CHANGE BOTH before any non-local deployment.
JWT_ACCESS_SECRET=sih26034-dev-access-secret-change-me
JWT_REFRESH_SECRET=sih26034-dev-refresh-secret-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# ── HTTP ────────────────────────────────────────────────────────────────────
# `*` during local development; a comma-separated origin list in production.
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Image storage ───────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=12

# ── Analysis ────────────────────────────────────────────────────────────────
# mock → scripted analyser (Phase 2). http → Python AI service (Phase 3).
# Flipping this variable is the entire integration step for real OCR.
ANALYSIS_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=20000
MOCK_ANALYSIS_DELAY_MS=1200

# ── OCR ─────────────────────────────────────────────────────────────────────
# The provider behind `OCRProvider`. Everything downstream — extraction, the
# rule engine, the report, both clients — depends on the interface and not on
# this value, so replacing the provider later is a change here and one class in
# src/services/ocr/.
#
#   paddle → PP-OCRv5 running locally in the ocr-service/ sidecar. THE DEFAULT.
#            Per-line confidence and bounding boxes, no per-scan cost, no
#            network, and the inspection photographs never leave the machine.
#            Needs the sidecar running — see ocr-service/README.md.
#   google → Google Cloud Vision DOCUMENT_TEXT_DETECTION. Also returns
#            confidence and polygons. Kept as the cloud comparison and as a
#            fallback where the sidecar cannot be deployed; costs per scan and
#            sends the photograph to a third party.
#   mock   → deterministic fixtures. READS NOTHING. Returns one of a few sample
#            labels chosen by hashing the image bytes, so the declarations you
#            get back belong to a sample package and not to the one you
#            photographed. Fine for CI and for demoing the rule engine; useless
#            for judging extraction accuracy.
OCR_PROVIDER=paddle

# Where the PaddleOCR sidecar is listening, when OCR_PROVIDER=paddle.
#
# Localhost on purpose: the service holds inspection photographs in memory and
# has no authentication of its own. It is meant to sit behind this backend on
# the same host. Pointing it at another machine puts a network boundary in
# front of the evidence, and that boundary has to be secured separately.
OCR_SERVICE_URL=http://localhost:8001

# Credentials for the cloud provider, when OCR_PROVIDER=google. Not needed by
# the default paddle provider, which has no credential at all.
#
# NEVER commit a real value, and never ship one to the mobile or web client:
# every OCR call is made from this process precisely so the credential stays on
# the server.
#
#   OCR_API_KEY                    a Vision-enabled Google Cloud API key.
#   GOOGLE_APPLICATION_CREDENTIALS absolute path to a service-account JSON file.
#
# The key wins if both are set.
OCR_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# How long to wait for the OCR service before giving up on one image.
# Per-image ceiling. A face that needs the sidecar's extra passes — a curved
# bottle, a dark MRP box — takes 23-27s; a clean one still takes 2-4s.
OCR_TIMEOUT_MS=45000

# Comma-separated BCP-47 hints. Indian packages are routinely bilingual; leave
# this empty to let the provider auto-detect.
OCR_LANGUAGE_HINTS=en,hi

# Pins the mock provider to one fixture instead of choosing by image content.
# One of: compliant, missing_declarations, imported_no_origin, low_confidence, blank
OCR_MOCK_FIXTURE=

# Visible processing time for the mock provider during a demo. Ignored in tests.
MOCK_OCR_DELAY_MS=600

# ── LLM ─────────────────────────────────────────────────────────────────────
#
# A language model reads the OCR text of every photograph, repairs what the
# camera misread — 5OO g, ४५, a smeared date, a rupee sign read as "?" — and
# returns every declaration printed on the package as structured JSON. That
# reading is what the rule engine evaluates; each value is tied back to the
# OCR line it came from so the report can still point at the photograph.
#
# The stage never decides anything about the law. If the key is missing, the
# quota is spent, or the call times out, the scan falls back to the
# deterministic pattern extractor and the report says so.
#
#   none     no model runs. The default, and what CI runs.
#   gemini   Google AI Studio. Chosen because the labels are bilingual and
#            correcting Devanagari needs a model that has actually seen it.
LLM_PROVIDER=none

# Google AI Studio key — https://aistudio.google.com/apikey
#
# NOT the same credential as OCR_API_KEY above. That one is a Google *Cloud*
# key for the Vision API and is billed per call; this is an AI Studio key with
# its own free tier. A Cloud key sent here returns 403.
#
# NEVER commit a value. NEVER ship one to the mobile or web client.
GEMINI_API_KEY=

# Left configurable because Google renames and retires these on its own
# schedule — gemini-2.5-flash already answers 404 for a new key.
#
# Chosen by measurement against this project's own noisy OCR text, not by
# version number:
#   gemini-3.7-flash       3.4s, repairs 5OO mI / 1S8.OO / lndia    ← default
#   gemini-3.6-flash       7.3s, just as accurate
#   gemini-3.5-flash-lite  2.7s, returns every error UNCORRECTED
#   gemini-3.8-flash       503 on every attempt
# Re-measure before changing it. A newer number is not evidence.
GEMINI_MODEL=gemini-3.7-flash

# Ceiling on the model call, set against what the models actually take (3.4s
# for the default, 7.3s for the next one — 8s cut off a working answer). It is
# a ceiling, not a cost: the ordinary call still returns in three seconds, and
# in the bad case the scan completes without the stage rather than the
# inspector waiting out the timeout for nothing.
# ── The model chain ─────────────────────────────────────────────────────────
# Tried in order, first to answer wins. A spent quota, an outage or a timeout
# falls through to the next entry on its own — one vendor's free tier is not a
# foundation, and a Gemini flash model allows twenty requests a *day*.
#
# Entries are `provider` or `provider:model`. Gemini leads because the labels
# are bilingual and it has read Devanagari; Groq follows because its allowance
# is measured in thousands rather than tens.
LLM_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.7-flash,groq:llama-3.3-70b-versatile

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

LLM_TIMEOUT_MS=20000

# How completely one, two, three or four-plus photographs are taken to have
# captured a package, as a 0-1 score printed on the report.
#
# Informational. No check turns on it: a declaration the reading did not find
# is recorded as not declared whatever the count, and the inspector settles it
# against the package before finalizing.
CAPTURE_COMPLETENESS_BY_IMAGE_COUNT=0.45,0.7,0.85,0.95

# ── Misc ────────────────────────────────────────────────────────────────────
# Seeds demo data on boot when the database is empty. Never overwrites data.
AUTO_SEED=true
LOG_LEVEL=info
