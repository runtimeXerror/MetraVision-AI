{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // `node10` is the current name for the classic Node CommonJS resolution
    // algorithm. It was spelled `node` until TypeScript 5.x, which deprecated
    // that spelling — editors strike it through, and TypeScript 6.0 stops
    // accepting it. This is a rename and nothing more: the resolution
    // behaviour is identical, which is why no import had to change with it.
    //
    // The alternative, `node16`/`nodenext`, is not a rename. It turns on
    // ESM-aware resolution, which requires explicit file extensions on every
    // relative import and honours `exports` maps in dependencies — a real
    // migration, and one worth doing deliberately rather than as a side effect
    // of silencing a deprecation.
    "moduleResolution": "node10",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
