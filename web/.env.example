# ── SIH26034 Web Dashboard — environment ────────────────────────────────────
# Copy to `.env`. Both values are optional for local development.

# Base URL of the backend API, including the /api suffix.
#
# LEAVE THIS EMPTY for local development: the Vite dev server proxies /api to
# the backend (see VITE_PROXY_TARGET), so the browser talks to its own origin
# and there is no CORS to configure.
#
# Set it for a deployed build:
#   VITE_API_URL=https://api.legalmetrology.gov.in/api
VITE_API_URL=

# Where the dev-server proxy forwards /api and /uploads.
# Change this if the backend is not on port 4000.
VITE_PROXY_TARGET=http://localhost:4000
